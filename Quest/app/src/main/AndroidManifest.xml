<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:metavr="http://schemas.meta.com/metavr-sdk" xmlns:horizonos="http://schemas.horizonos/sdk">
    <metavr:uses-metavr-sdk metavr:minSdkVersion="69" metavr:targetSdkVersion="207" />
    <!-- Hybrid declaration understood by releases before the OS 207 schema. -->
    <horizonos:uses-horizonos-sdk horizonos:minSdkVersion="69" horizonos:targetSdkVersion="69" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />
    <uses-feature android:glEsVersion="0x00030001" android:required="true" />
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <uses-feature android:name="com.oculus.feature.RENDER_MODEL" android:required="false" />
    <uses-permission android:name="com.oculus.permission.RENDER_MODEL" />
    <application android:label="Convolution" android:allowBackup="false" android:usesCleartextTraffic="true" android:theme="@android:style/Theme.Material.NoActionBar">
        <uses-native-library android:name="libossdk.oculus.so" android:required="true" />
        <meta-data android:name="com.oculus.handtracking.version" android:value="V2.0" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|quest3|quest3s" />
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:resizeableActivity="true">
            <layout android:defaultWidth="1000dp" android:defaultHeight="720dp" />
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /><category android:name="com.oculus.intent.category.2D" /></intent-filter>
        </activity>
        <activity android:name=".HomePlayerActivity" android:exported="false" android:resizeableActivity="true">
            <layout android:defaultWidth="1280dp" android:defaultHeight="900dp" />
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="com.oculus.intent.category.2D" /></intent-filter>
        </activity>
        <activity android:name=".SpatialPlayerActivity" android:exported="false" android:launchMode="singleTask" android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode" android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="com.oculus.intent.category.VR" /></intent-filter>
        </activity>
        <activity android:name=".PlayerActivity" android:exported="false" android:launchMode="singleTask" android:screenOrientation="landscape"
                  android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
                  android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="quest_player" />
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="com.oculus.intent.category.VR" /></intent-filter>
        </activity>
    </application>
</manifest>
