<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A self-checking console for the spatial video stream's decisions (the
    playlist, which segments a run converts, which runs a seek or the server's
    run limit stops, what the cache trims, when info.json holds), which live in
    SpatialStreamPlanning.cs apart from the processes and Jellyfin services, so
    none of the plugin's Jellyfin references are needed. Run it with dotnet run
    on this folder; it exits non-zero if a rule fails.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Jellyfin.Plugin.AtmosObjects/SpatialInfo.cs" Link="SpatialInfo.cs" />
    <Compile Include="../Jellyfin.Plugin.AtmosObjects/SpatialStreamPlanning.cs" Link="SpatialStreamPlanning.cs" />
  </ItemGroup>

</Project>
