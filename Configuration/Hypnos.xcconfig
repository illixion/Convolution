//
// Hypnos.xcconfig
//

// Signing configuration.
// LocalSigning.xcconfig (gitignored) overrides DefaultSigning.xcconfig when present.
// Copy LocalSigning.xcconfig.example to LocalSigning.xcconfig to customize.
#include "DefaultSigning.xcconfig"
#include? "LocalSigning.xcconfig"

// Git commit hash, generated by scripts/set-build-info.sh at build time.
// BuildInfo.xcconfig is gitignored; the optional include means builds work
// without it (COMMIT_HASH resolves empty → Settings shows version only).
#include? "../Hypnos/BuildInfo.xcconfig"

// Private-API code, for GitHub-only builds. Empty here so every ordinary
// build — including anything destined for the App Store — compiles the private
// code out entirely. Opt in with `~/bin/build-and-sign --private-api`, which
// sets PRIVATE_API_CONDITION on the xcodebuild command line. Gates Raw Splat 3D
// and Settings → Developer → Spatial 3D Tuning on visionOS
// (PrivateSpatial3DTuning.swift) and the iOS ImagePresentationComponent probe
// (PrivateSpatial3DiOS.swift).
PRIVATE_API_CONDITION =

// YouTube playback, for sideload builds only. Empty here, so no build
// compiles it unless asked: other visionOS YouTube players were pulled from
// the App Store, and until that question is settled none of this code may
// reach a submission. Opt in with
// `~/bin/build-and-sign --set YOUTUBE_CONDITION=HYPNOS_YOUTUBE`, or in the
// gitignored scripts/build-signing.conf / LocalSigning.xcconfig.
YOUTUBE_CONDITION =

// FFmpeg's DTS and TrueHD decoders, for sideload builds only (CLAUDE.md, "An
// App Store build never does Dolby processing itself"): the on-device MKV
// remux then plays those tracks as lossless ALAC instead of dropping them.
// Needs `scripts/build-ffmpeg-decoders.sh` run first (the FFmpegDecoders
// package is a stub without it). Opt in with
// `~/bin/build-and-sign --set FFMPEG_CONDITION=HYPNOS_FFMPEG`, or in the
// gitignored scripts/build-signing.conf / LocalSigning.xcconfig.
FFMPEG_CONDITION =

// Dolby Vision RPU processing on the device, for sideload builds only
// (CLAUDE.md, "An App Store build never does Dolby processing itself"): the
// on-device MKV remux plays a UHD Blu-ray's profile 7 as profile 8.1, its
// enhancement layer dropped and every RPU rewritten by FFmpeg, instead of as
// its HDR10 base layer. Needs HYPNOS_FFMPEG as well (the rewriter is in the
// same HypnosFFmpeg.framework; a build with HYPNOS_DOVI alone stops with an
// #error). Opt in with
// `~/bin/build-and-sign --set FFMPEG_CONDITION=HYPNOS_FFMPEG --set DOVI_CONDITION=HYPNOS_DOVI`,
// or in the gitignored scripts/build-signing.conf / LocalSigning.xcconfig.
DOVI_CONDITION =

// Larger depth models whose weights are licensed for non-commercial use only
// (Depth Anything V2 Base and Large, CC-BY-NC-4.0), offered as downloads with
// their licence shown, for sideload builds only (CLAUDE.md, "Larger depth
// models are sideload-only"). Empty here, so no build names them or offers
// them unless asked. Opt in with
// `~/bin/build-and-sign --set NC_MODELS_CONDITION=HYPNOS_NC_MODELS`, or in the
// gitignored scripts/build-signing.conf / LocalSigning.xcconfig.
NC_MODELS_CONDITION =

// DTS:X object audio, for sideload builds only: the app lists `dtsx` among
// the object-audio formats it asks the Atmos Objects plugin for
// (ObjectAudioEdition.swift), and the plugin then decodes a DTS:X track's
// objects with harletty on the server, as it does TrueHD Atmos with truehdd.
// Nothing DTS is compiled into the app either way. Empty here, so a
// submission build never asks for it. Opt in with
// `~/bin/build-and-sign --set DTSX_CONDITION=HYPNOS_DTSX`, or in the
// gitignored scripts/build-signing.conf / LocalSigning.xcconfig.
DTSX_CONDITION =

// Generated 3D, a private research spike: a picture to a wrap-around model
// through Gen3DServer (Gen3DServer/README.md), on visionOS. Empty here, so no
// submission build compiles it. Opt in with
// `~/bin/build-and-sign --set GEN3D_CONDITION=HYPNOS_GEN3D`, or in the
// gitignored scripts/build-signing.conf / LocalSigning.xcconfig. (It links
// AnythingUSDZKit in every build, as SwiftPM can't link per flag; the code that
// calls it is compiled out.)
GEN3D_CONDITION =

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(PRIVATE_API_CONDITION) $(YOUTUBE_CONDITION) $(FFMPEG_CONDITION) $(DOVI_CONDITION) $(NC_MODELS_CONDITION) $(DTSX_CONDITION) $(GEN3D_CONDITION)

// HomeKit for the sleep timer's accessory actions, on iOS and visionOS. Empty
// here: the shared sideload wildcard profile has no HomeKit capability, and an
// entitlement the profile lacks stops the app installing. A build whose App ID
// and profile carry the capability (an App Store build, or a sideload with its
// own profile) opts in with `HOMEKIT_ENTITLEMENTS=Hypnos/HypnosHomeKit.entitlements`
// (`~/bin/build-and-sign --set HOMEKIT_ENTITLEMENTS=...`, or the gitignored
// scripts/build-signing.conf / LocalSigning.xcconfig). tvOS always has it
// (HypnosTV.entitlements; the tvOS dev profile carries it) and the Mac has no
// HomeKit at all. Home Assistant needs none of this.
HOMEKIT_ENTITLEMENTS =
CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] = $(HOMEKIT_ENTITLEMENTS)
CODE_SIGN_ENTITLEMENTS[sdk=xros*] = $(HOMEKIT_ENTITLEMENTS)
