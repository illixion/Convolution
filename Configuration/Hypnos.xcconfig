//
// Hypnos.xcconfig
//

// Signing configuration.
// LocalSigning.xcconfig (gitignored) overrides DefaultSigning.xcconfig when present.
// Copy LocalSigning.xcconfig.example to LocalSigning.xcconfig to customize.
#include "DefaultSigning.xcconfig"
#include? "LocalSigning.xcconfig"

// Git commit hash, generated by scripts/set-build-info.sh at build time.
// BuildInfo.xcconfig is gitignored; the optional include means builds work
// without it (COMMIT_HASH resolves empty → Settings shows version only).
#include? "../Hypnos/BuildInfo.xcconfig"

// Private-API code, for GitHub-only builds. Empty here so every ordinary
// build — including anything destined for the App Store — compiles the private
// code out entirely. Opt in with `~/bin/build-and-sign --private-api`, which
// sets PRIVATE_API_CONDITION on the xcodebuild command line. Currently gates
// the iOS ImagePresentationComponent probe (see PrivateSpatial3DiOS.swift).
PRIVATE_API_CONDITION =

// YouTube playback, for sideload builds only. Empty here, so no build
// compiles it unless asked: other visionOS YouTube players were pulled from
// the App Store, and until that question is settled none of this code may
// reach a submission. Opt in with
// `~/bin/build-and-sign --set YOUTUBE_CONDITION=HYPNOS_YOUTUBE`, or in the
// gitignored scripts/build-signing.conf / LocalSigning.xcconfig.
YOUTUBE_CONDITION =

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(PRIVATE_API_CONDITION) $(YOUTUBE_CONDITION)
